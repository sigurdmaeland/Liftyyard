# Lokale utviklingsverdier. Kopier til .env (som ikke sjekkes inn): cp .env.example .env
# Brukes av docker compose og av backend (application.yml importerer ../.env).
POSTGRES_HOST=localhost
# 5433 i stedet for 5432 for å unngå konflikt med en eventuell lokal PostgreSQL.
POSTGRES_PORT=5433
POSTGRES_DB=fitness
POSTGRES_USER=fitness
POSTGRES_PASSWORD=bytt-meg-lokalt

# Innlogging. Lag en egen tilfeldig verdi, f.eks.: openssl rand -base64 48
AUTH_JWT_SECRET=bytt-meg-til-en-lang-tilfeldig-verdi-pa-minst-32-tegn
# Google OAuth: web-klientens ID fra Google Cloud Console (se docs/auth.md). Tom = Google-innlogging av.
GOOGLE_CLIENT_IDS=
# E-post. Lokalt brukes Mailpit fra compose.yaml.
MAIL_HOST=localhost
MAIL_PORT=1025


# Bilder lagres lokalt i denne mappen (relativt til backend/). I drift: MEDIA_STORAGE=s3 med Cloudflare R2.
MEDIA_STORAGE=local
MEDIA_DIR=data/media
# Adressen telefonen henter bilder fra. iOS-simulatoren når Mac-ens localhost.
MEDIA_PUBLIC_URL=http://localhost:8080/media

# Bare i drift (Railway), se docs/deploy-railway.md:
# MEDIA_STORAGE=s3
# S3_ENDPOINT=https://<konto-ID>.r2.cloudflarestorage.com
# S3_BUCKET=liftyard-media
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
