# Kopier til .env. EXPO_PUBLIC_-verdier bygges inn i appen og er offentlige.
# iOS Simulator: http://localhost:8080   Android Emulator: http://10.0.2.2:8080
EXPO_PUBLIC_API_URL=http://localhost:8080

# Google-innlogging (bare i appens egen utviklerversjon, ikke Expo Go). Se docs/auth.md.
# Web-klienten brukes som mottaker av ID-tokenet; den samme ID-en settes i GOOGLE_CLIENT_IDS i backendens .env.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
